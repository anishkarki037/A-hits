// views/header.anix

nav.header-container {
  // Logo on the left
  div.logo {
    span.logo-n 'A'
    span 'hits.'
  }

 
div.search-container {
  input(type='text', placeholder='Search products...')
  
  button.refresh-btn {
    svg(xmlns="http://www.w3.org/2000/svg", width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round") {
      circle(cx="11", cy="11", r="8")
      line(x1="21", y1="21", x2="16.65", y2="16.65")
    }
  }
}

  // User actions on the right
  div.user-actions {
    // Shopping Bag Icon SVG
    svg.icon(xmlns="http://www.w3.org/2000/svg", width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round") {
      path(d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z")
      line(x1="3", y1="6", x2="21", y2="6")
      path(d="M16 10a4 4 0 0 1-8 0")
    }

    // Heart Icon SVG
    svg.icon(xmlns="http://www.w3.org/2000/svg", width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round") {
      path(d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z")
    }

    // User name and profile picture
    span.user-name 'Ryman Alex'
    img.profile-img(src='https://i.pravatar.cc/40?u=rymanalex', alt='User profile picture')
  }
}